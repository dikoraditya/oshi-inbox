# SumoPod / self-hosted env template.
#
# Local (docker compose): copy this to `.env` beside docker-compose.yml — compose
# reads it automatically.
# SumoPod: set each of these as the app container's environment variables (the
# DB ones go on the Postgres container; DATABASE_URL is derived from them).
#
# DB_DRIVER, MEDIA_STORAGE, and MEDIA_DIR are fixed for this topology and are set
# in docker-compose.yml, so you do NOT put them here. On SumoPod (no compose) set
# them on the app container too: DB_DRIVER=pg, MEDIA_STORAGE=local,
# MEDIA_DIR=/app/public/media, plus DATABASE_URL to the Postgres container.

# ── Postgres (self-hosted container) ─────────────────────────────────────────
# Strong password for the bundled Postgres. compose derives DATABASE_URL from it
# (postgres://oshi:<POSTGRES_PASSWORD>@db:5432/oshi).
POSTGRES_PASSWORD=

# ── App security — MUST set on a public URL ──────────────────────────────────
# Passphrase gate for the whole UI.
APP_PASSWORD=
# Bearer secret the in-container scheduler uses to call /api/cron/* (drain, etc).
CRON_SECRET=
# Shared secret for POST /api/ingest — must equal the collector's INGEST_SECRET.
INGEST_SECRET=

# ── Translation ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Cheap model for the backlog. Omit to fall back to the (pricey) built-in default.
TRANSLATE_MODEL=claude-haiku-4-5

# ── Nogizaka fan-name substitution (%%% in a message -> this) ────────────────
FAN_NICKNAME=

# ── COSM in-app Fetch (=LOVE / ≠ME / ≒JOY) — optional ────────────────────────
COSM_USERNAME=
COSM_PASSWORD=
COSM_EQUAL_LOVE_UUID=
COSM_NOT_EQUAL_ME_UUID=
COSM_NEARLY_EQUAL_JOY_UUID=
COSM_REQUEST_VERIFICATION_KEY=

# ── NMB48 b.stage in-app Fetch (POP DM) — optional ───────────────────────────
BSTAGE_EMAIL=
BSTAGE_PASSWORD=

# Gmail (AKB mobame): deferred on purpose — omitted. Add GOOGLE_*, GMAIL_*,
# PUBSUB_* here later if you wire up the public Pub/Sub push endpoint.
