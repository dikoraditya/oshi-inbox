# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string.
#   Cloud:  a Neon/Vercel Postgres URL (`vercel env pull` fills this in).
#   Local:  a plain Postgres, e.g. postgres://postgres:postgres@localhost:5432/oshi
# A localhost URL auto-selects the node-postgres driver; anything else uses
# Neon's HTTP driver. Override with DB_DRIVER below.
DATABASE_URL=postgres://...

# Force the database driver regardless of the URL: `pg` (local Postgres) or
# `neon` (Neon HTTP). Leave blank to auto-detect from DATABASE_URL.
DB_DRIVER=

# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship the key to
# the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Passphrase gate. If unset the app is wide open, which is fine on localhost and
# reckless on a public URL — always set it in production.
APP_PASSWORD=

# ── Gmail ingestion ─────────────────────────────────────────────────────────

# From a Google Cloud OAuth 2.0 client (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <deployment>/api/gmail/callback, which is what you
# register as the authorised redirect URI.
GOOGLE_REDIRECT_URI=

# The Gmail label you file idol mail into.
GMAIL_LABEL=oshi

# Pub/Sub topic Gmail publishes to: projects/<project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=

# How /api/gmail/push authenticates its caller. Set ONE of these — with neither,
# the endpoint refuses every request rather than accepting anonymous writes.
#
#   PUBSUB_AUDIENCE       preferred: the audience configured on the push
#                         subscription's OIDC token
#   PUBSUB_PUSH_SECRET    simpler: append ?token=<value> to the push endpoint URL
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
PUBSUB_PUSH_SECRET=

# ── Collector ingestion (Weverse / Nogizaka / COSM) ─────────────────────────

# Shared secret for POST /api/ingest, sent by the local collector as
# `Authorization: Bearer <value>`. Unset means the endpoint refuses everything,
# same fail-closed rule as the Gmail push endpoint above. Put the same value in
# collector/.env as INGEST_SECRET.
INGEST_SECRET=

# ── COSM in-app Fetch (=LOVE / ≠ME / ≒JOY) ──────────────────────────────────
#
# COSM is a pure REST source, so the app's "Fetch" buttons pull it server-side
# with these — no local collector needed for =LOVE/≠ME/≒JOY. (Weverse/Nogizaka
# still need the browser-driven collector.) Leave unset to hide the buttons /
# make the Fetch buttons no-op for COSM.
COSM_USERNAME=
COSM_PASSWORD=
# Per-group x-artist-group-uuid (DevTools → Network → x-artist-group-uuid). Only
# groups with a uuid here are fetched.
COSM_EQUAL_LOVE_UUID=
COSM_NOT_EQUAL_ME_UUID=
COSM_NEARLY_EQUAL_JOY_UUID=
# Connect-RPC verification key for COSM login. Copy the `x-request-verification-key`
# request header (rvk_...) from the LINK web portal in DevTools → Network. COSM
# login 403s without it.
COSM_REQUEST_VERIFICATION_KEY=

# ── NMB48 b.stage in-app Fetch (POP DM) ─────────────────────────────────────
#
# b.stage is a pure REST source too. v1 pulls each subscribed member's LATEST POP
# message per run (full history is native-app-only). Plain email/password login.
BSTAGE_EMAIL=
BSTAGE_PASSWORD=
# Tenant/stage id; defaults to nmb48-global.
# BSTAGE_STAGE_ID=nmb48-global

# ── Media storage (pics + videos) ────────────────────────────────────────────
#
# Where attached/ingested images and videos are stored:
#   local  — the machine's own disk under public/media, served as static files.
#            Free and unbounded; the default for a local run with no Blob token.
#   blob   — Vercel Blob (needs BLOB_READ_WRITE_TOKEN). Required on Vercel, whose
#            filesystem is read-only/ephemeral.
#   both   — write every file to Blob AND disk (needs BLOB_READ_WRITE_TOKEN).
#            Redundant copies; each write is best-effort so one backend failing
#            never drops the media.
# Unset auto-selects: blob when a token is present, else local.
MEDIA_STORAGE=
# In `both` mode, which copy's URL is stored on the message row (the canonical
# one that gets served); the other is a mirror. `blob` (default) serves from the
# CDN with disk as backup; `local` serves from disk with Blob as backup.
MEDIA_PRIMARY=
# Optional. Overrides where local media is written (default: ./public/media).
MEDIA_DIR=

# Created when you attach a Vercel Blob store. Needed for MEDIA_STORAGE=blob or
# both (and on Vercel). Pure-local runs can leave this unset.
BLOB_READ_WRITE_TOKEN=

# ── Vercel-provided ──────────────────────────────────────────────────────────

# Vercel sets this itself; cron routes check it. Local runs skip the check.
CRON_SECRET=
